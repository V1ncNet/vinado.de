---
import OpenGraph from "../components/OpenGraph.astro";
import Theme from "../components/Theme.astro";
import Twitter from "../components/Twitter.astro";

import "../styles/tw.css";

const title = "Vincent Nadoll • Lebenslauf";
const ogTitle = "Lebenslauf";
const ogDescription = "Mehrjährige Erfahrung in Softwareentwicklung - Bachelor of Engineering - Musiker als Chorsänger - Sozial engagiert";
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="author" content="Vincent Nadoll" />
    <meta name="robots" content="noindex" />
    <OpenGraph title={ogTitle} description={ogDescription} />
    <Twitter title={ogTitle} description={ogDescription} />
    <Theme />
    <link rel="author" type="text/plain" href="/humans.txt" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <title>{title}</title>
  </head>

  <body class="font-light text-base md:text-xl leading-normal!">
    <h1>Lebenslauf</h1>
    <main class="sections">
      <section>
        <h2>Berufserfahrung</h2>
        <div>
          <article>
            <div class="head">
              <span><b>intecsoft GmbH</b></span>
              <span class="period">April 2019 – heute</span>
            </div>
            <p>
               Softwareentwickler
            </p>
            <ul>
              <li>Backend-Entwicklung</li>
              <li>Softwarekonzeption</li>
              <li>Projektkoordination</li>
            </ul>
          </article>
          <article>
            <div class="head">
              <span><b>Vinado Design</b></span>
              <span class="period">Juni 2016 – heute</span>
            </div>
            <p>
               Selbstständig
            </p>
            <ul>
              <li>Webdesign und -entwicklung</li>
              <li>Consulting</li>
            </ul>
          </article>
          <article>
            <div class="head">
              <span><b>intecsoft GmbH</b></span>
              <span class="period">November 2016 – März 2019</span>
            </div>
            <p>
               Werkstudent
            </p>
            <ul>
              <li>Full-Stack-Entwicklung</li>
              <li>IT-Supportdienstleistung</li>
            </ul>
          </article>
          <article>
            <div class="head">
              <span><b>Maritim Hotel & Internationales Congress Center Dresden</b></span>
              <span class="period">Oktober 2015 – September 2016</span>
            </div>
            <p>
               Technikaushilfe im Kongresszentrum
            </p>
          </article>
          <article>
            <div class="head">
              <span><b>intecsoft GmbH</b></span>
              <span class="period">Oktober 2014 – April 2015</span>
            </div>
            <p>
               Werksstudent
            </p>
            <ul>
              <li>Native Appentwicklung (Android)</li>
            </ul>
          </article>
        </div>
      </section>
      <section>
        <h2>Ausbildung</h2>
        <div>
          <article>
            <div class="head">
              <span><b>Berufsakademie Sachsen<br />Staatliche Studienakademie Dresden</b></span>
              <span class="period">Oktober 2019 – Januar 2023</span>
            </div>
            <p>
               Studiengang: Informationstechnologie - Medieninformatik<br />
               Abschluss: Bachelor of Engineering (Note „gut“)<br />
            </p>
            <ul>
              <li>
                SS 2022 Projektmanagement und Medienprojekt<br />
                 Projektverantwortung in einem Scrum Team
              </li>
              <li>
                WS 2021/2022 Interaktive Medien<br />
                 Entwicklung einer VR-Simulation mit Unity und<br />
                 3D-Modellierung in Blender
              </li>
            </ul>
          </article>
          <article>
            <div class="head">
              <span><b>Hochschule für Technik und Wirtschaft Dresden</b></span>
              <span class="period">September 2017 – Februar 2019</span>
            </div>
            <p>
               Studiengang: Informatik<br />
               Angestrebter Abschluss: Bachelor of Science<br />
            </p>
          </article>
          <article>
            <div class="head">
              <span><b>Technische Universität Dresden</b></span>
              <span class="period">Oktober 2013 – Januar 2017</span>
            </div>
            <p>
               Studiengang: Medieninformatik<br />
               Angestrebter Abschluss: Bachelor of Science
            </p>
            <ul>
              <li>
                SS 2015 Lernspielpraktikum<br />
                 Entwicklung eines Lernspiels im Rahmen des Moduls Medienpsychologie und -didaktik
              </li>
              <li>
                WS 2014/2015 Softwaretechnologiepraktikum<br />
                 Entwicklung einer webbasierten Verwaltungssoftware in Java
              </li>
              <li>WS 2014/2015 Tutor für Programmierkurs in C</li>
              <li>
                WS 2013/2014 Robolab Praktikum<br />
                 Programmierung eines LEGO Mindstorms in C
              </li>
            </ul>
          </article>
          <article>
            <div class="head">
              <span><b>Landesgymnasium für Musik Wernigerode</b></span>
              <span class="period">2009 – 2013</span>
            </div>
            <p>
               Abschluss: Abitur 2013
            </p>
          </article>
        </div>
      </section>
      <section>
        <h2>Kenntnisse und Fähigkeiten</h2>
        <div>
          <div class="grid grid-cols-2">
            <div>
              <dl>
                <dt>Sprachen</dt>
                <dd>
                  Deutsch<br />
                   Englisch (GER B2+)
                </dd>
                <dt>Kompetenzen</dt>
                <dd>
                  Frontend- und Backend-Entwicklung<br />
                   Webdesign<br />
                   DevOps-Entwicklung<br />
                   Entwicklerwerkzeuge
                </dd>
              </dl>
            </div>
            <div>
              <dl>
                <dt>Programmiersprachen und Vglb</dt>
                <dd>
                  Java<br />
                   JavaScript/TypeScript<br />
                   HTML<br />
                   CSS<br />
                   PHP<br />
                   SQL<br />
                   C/C++<br />
                </dd>
              </dl>
            </div>
          </div>
        </div>
      </section>
      <section>
        <h2>Engagement</h2>
        <div>
          <article>
            <div class="head">
              <span><b>ascii Dresden e.V.</b> (ehem. Studenteninitiative IZ e.V.)</span>
              <span class="period">Oktober 2017 – März 2019</span>
            </div>
            <p>
               Vorstandsvorsitzender
            </p>
          </article>
          <article>
            <div class="head">
              <span><b>Junger Männerchor Wernigerode e.V.</b></span>
              <span class="period">August 2015 – August 2017</span>
            </div>
            <p>
               Vorstandsmitglied für Proben- und Konzertorganisation
            </p>
          </article>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
body {
  font-family: var(--font-family-sans-serif);
  color: var(--dark);
  background-color: var(--white);
  padding: 0 1rem 2rem;
}

h1, h2, dt, b {
  font-weight: 700;
}

h1 {
  text-transform: uppercase;
  text-align: center;
  margin-top: 3rem;
  margin-bottom: 3rem;
  font-size: 2.2rem;
  opacity: 0.9;
}

h2 {
  text-transform: uppercase;
  font-size: 1.5rem;
  line-height: 1.2;
  margin-bottom: 0.5rem;
}

.sections {
  max-width: 1140px;
  margin-inline: auto;
}

section > div {
  margin-bottom: 1.5rem;
}

article {
  margin-bottom: 1rem;
}

.head {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  column-gap: 1rem;
}

.period {
  order: -1;
  flex-basis: 100%;
  white-space: nowrap;
  font-size: 0.9rem;
  color: var(--gray-dark);
}

ul {
  margin-top: -0.8rem;
  margin-bottom: 1rem;
  padding-left: 20px;
}

dd {
  margin-bottom: 0.5rem;
}

@media screen and (min-width: 64rem) {
  .head {
    flex-wrap: wrap-reverse;
  }

  .period {
    order: 0;
    flex-basis: auto;
  }
}

@media screen and (min-width: 64rem), print {
  .sections {
    display: grid;
    grid-template-columns: min-content minmax(0, 1fr);
    column-gap: 2rem;
  }

  section {
    display: contents;
  }
}

@media print {
  :global(html) {
    font-size: 10pt;
  }

  body {
    font-size: 1rem;
  }

  article, dl {
    break-inside: avoid;
  }
}
</style>
